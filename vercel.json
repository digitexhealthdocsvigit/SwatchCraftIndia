{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "samplinghub.world" }],
      "destination": "https://www.samplinghub.world/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
